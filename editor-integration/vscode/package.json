{
  "name": "protoscala",
  "displayName": "protoScala",
  "description": "Scala syntax highlighting and debugging of protoScala scripts through the protoscala --dap Debug Adapter Protocol adapter.",
  "version": "0.4.1",
  "publisher": "protoscala-placeholder",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onDebugResolve:protoscala",
    "onDebugDynamicConfigurations:protoscala",
    "onLanguage:scala"
  ],
  "contributes": {
    "configuration": {
      "title": "protoScala",
      "properties": {
        "protoscala.path": {
          "type": "string",
          "default": "",
          "description": "Path to the protoscala executable. Empty: the default install location, then 'protoscala' on PATH."
        }
      }
    },
    "languages": [
      {
        "id": "scala",
        "aliases": [
          "Scala",
          "scala"
        ],
        "extensions": [
          ".scala",
          ".sc"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^#!.*\\bprotoscala\\b"
      }
    ],
    "grammars": [
      {
        "language": "scala",
        "scopeName": "source.scala",
        "path": "./syntaxes/scala.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "scala"
      }
    ],
    "debuggers": [
      {
        "type": "protoscala",
        "label": "protoScala",
        "languages": [
          "scala"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Scala script to debug (run by the protoScala interpreter).",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the script's @main method.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the script.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line of the script.",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "default": false,
                "description": "Steps never stop in the prelude (protoScala's library). Breakpoints set in it still stop."
              },
              "pathMappings": {
                "type": "array",
                "default": [
                  {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/home/user/project"
                  }
                ],
                "description": "Translate paths between this machine (localRoot) and the machine where protoscala runs (remoteRoot), longest root first. Files under no mapping are shown read-only from the adapter.",
                "items": {
                  "type": "object",
                  "required": [
                    "localRoot",
                    "remoteRoot"
                  ],
                  "properties": {
                    "localRoot": {
                      "type": "string",
                      "description": "A directory on this machine."
                    },
                    "remoteRoot": {
                      "type": "string",
                      "description": "The same directory where protoscala runs."
                    }
                  }
                }
              },
              "remote": {
                "type": "object",
                "description": "Run the adapter elsewhere: '<command...> <path> --dap'. Needs pathMappings. The remote shell must print nothing on a non-interactive start.",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The argv prefix that reaches the other machine, e.g. [\"ssh\", \"-T\", \"-o\", \"BatchMode=yes\", \"user@host\"] or [\"wsl\", \"-d\", \"Ubuntu-24.04\", \"--\"]."
                  },
                  "path": {
                    "type": "string",
                    "default": "protoscala",
                    "description": "The protoscala executable on the other machine."
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "protoscala",
            "request": "launch",
            "name": "Debug current protoScala script",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "protoScala: Launch current script",
            "description": "Debug the active .scala file with the protoScala interpreter.",
            "body": {
              "type": "protoscala",
              "request": "launch",
              "name": "Debug current protoScala script",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "protoScala: Launch over SSH",
            "description": "Run protoscala --dap on another machine through ssh; paths are mapped by the adapter.",
            "body": {
              "type": "protoscala",
              "request": "launch",
              "name": "Debug over SSH",
              "program": "^\"\\${file}\"",
              "remote": {
                "command": [
                  "ssh",
                  "-T",
                  "-o",
                  "BatchMode=yes",
                  "user@host"
                ],
                "path": "/home/user/.local/bin/protoscala"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          },
          {
            "label": "protoScala: Launch in WSL",
            "description": "Run the Linux protoscala inside WSL; the Windows workspace is mapped to its /mnt path or a Linux clone.",
            "body": {
              "type": "protoscala",
              "request": "launch",
              "name": "Debug in WSL",
              "program": "^\"\\${file}\"",
              "remote": {
                "command": [
                  "wsl",
                  "-d",
                  "Ubuntu-24.04",
                  "--"
                ],
                "path": "/home/user/.local/bin/protoscala"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gamarino/protoScala"
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "mocha": "10.8.2"
  }
}
