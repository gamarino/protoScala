#include "support/PreludeImage.h"

#include <cstring>

namespace protoScala {

const char* preludeSource() {
    return R"proto_prelude(@PROTOSCALA_PRELUDE_SOURCE@)proto_prelude";
}

// FNV-1a-64 over the embedded source. Computed once: the image check needs it
// on every start-up, and hashing ~10 KB is tens of microseconds. A
// function-local static is correct here and only here — it holds a
// std::uint64_t, not a protoCore symbol, so the per-ProtoSpace interning rule
// does not apply.
std::uint64_t preludeSourceHash() {
    static const std::uint64_t h = [] {
        const char* s = preludeSource();
        return fnv1a64(s, std::strlen(s));
    }();
    return h;
}

} // namespace protoScala
